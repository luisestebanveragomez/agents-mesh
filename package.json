{
  "name": "agents-mesh",
  "version": "0.2.20",
  "description": "Multi-agent communication via filesystem for AI coding agents",
  "type": "module",
  "bin": {
    "agents-mesh": "src/cli/index.ts"
  },
  "scripts": {
    "dev": "bun src/mcp/server.ts",
    "test": "bun test",
    "build": "bun build src/mcp/server.ts --outdir dist --target bun",
    "dashboard": "bun src/dashboard/server.ts",
    "cli": "bun src/cli/index.ts",
    "dev:on": "sudo sh scripts/dev-on.sh",
    "dev:off": "sudo sh scripts/dev-off.sh"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "bun-types": "latest"
  }
}
